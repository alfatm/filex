{
  "name": "filex-e2e",
  "version": "0.34.0",
  "private": true,
  "type": "module",
  "description": "filex end-to-end test suite (Playwright)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:app": "playwright test --config playwright.app.config.ts",
    "test:app:ui": "playwright test --config playwright.app.config.ts --ui",
    "test:app:update": "playwright test --config playwright.app.config.ts --update-snapshots",
    "test:app:live": "node run.mjs app --build",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium",
    "codegen": "playwright codegen http://localhost:5212/admin"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
