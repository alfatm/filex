# filex full image — a slim image plus the programs the thumbnailer shells out
# to. BASE_IMAGE must be an image built from backend/Dockerfile (or the `slim`
# target of docker/Dockerfile):
#   docker build -f Dockerfile.full --build-arg BASE_IMAGE=filex:slim .
ARG BASE_IMAGE=filex:slim
FROM ${BASE_IMAGE}
USER root
RUN apk --no-cache add \
    ffmpeg \
    imagemagick \
    ghostscript \
    poppler-utils \
    libreoffice \
    openjdk17-jre-headless \
    rsvg-convert \
    ttf-liberation \
    ttf-dejavu \
    font-noto \
    font-noto-cjk
