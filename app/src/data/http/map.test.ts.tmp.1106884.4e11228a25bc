import { describe, expect, it } from 'vitest';
import { nodeKind, storagePath, toNode, toStorage, type WireNode } from './map';

const wire: WireNode = {
  id: 42,
  storage_id: 1,
  parent_id: 7,
  name: 'notes.md',
  path: 'Docs/notes.md',
  type: 'file',
  size: 2048,
  mime: 'text/markdown',
  created_at: '2026-07-01T09:12:00Z',
  updated_at: '2026-07-08T11:24:00Z',
  db_mtime: '2026-07-08T10:00:00Z',
};

describe('wire mapping', () => {
  it('turns int64 ids into strings and keeps a missing parent null', () => {
    expect(toNode(wire, 'me').id).toBe('42');
    expect(toNode(wire, 'me').parentId).toBe('7');
    expect(toNode({ ...wire, parent_id: null }, 'me').parentId).toBeNull();
    expect(toNode({ ...wire, parent_id: undefined }, 'me').parentId).toBeNull();
  });

  it('prefers the content clock over the row clock for "modified"', () => {
    expect(toNode(wire, 'me').modifiedAt).toBe('2026-07-08T10:00:00Z');
    const { db_mtime: _, ...withoutMtime } = wire;
    expect(toNode(withoutMtime, 'me').modifiedAt).toBe('2026-07-08T11:24:00Z');
  });

  it('derives the file type from the name, and leaves folders without one', () => {
    expect(toNode(wire, 'me').fileType).toBe('md');
    expect(toNode({ ...wire, name: 'photo.JPG' }, 'me').fileType).toBe('image');
    const folder = toNode({ ...wire, type: 'dir', name: 'Docs' }, 'me');
    expect(folder.kind).toBe('folder');
    expect(folder.fileType).toBeUndefined();
  });

  it('reads the server’s folder spellings', () => {
    expect(nodeKind('dir')).toBe('folder');
    expect(nodeKind('file')).toBe('file');
    expect(nodeKind('symlink')).toBe('file');
  });

  it('carries the trash and star flags through', () => {
    const trashed = toNode({ ...wire, deleted_at: '2026-07-09T08:00:00Z', starred: true }, 'me');
    expect(trashed.deletedAt).toBe('2026-07-09T08:00:00Z');
    expect(trashed.starred).toBe(true);
    expect(toNode(wire, 'me').deletedAt).toBeUndefined();
    expect(toNode(wire, 'me').starred).toBe(false);
  });

  it('maps a storage with its quota, treating an unlimited one as zero', () => {
    expect(toStorage({ id: 3, name: 'demo' }, '1', { used_bytes: 100, total_bytes: 1000 })).toEqual({
      id: '3',
      name: 'demo',
      rootId: '1',
      quota: { usedBytes: 100, totalBytes: 1000 },
    });
    expect(toStorage({ id: 3, name: 'demo' }, '1', null).quota).toEqual({ usedBytes: 0, totalBytes: 0 });
    expect(toStorage({ id: 3, name: 'demo' }, '1', { quota_bytes: 500 }).quota.totalBytes).toBe(500);
  });

  it('addresses a node the way the manager endpoints expect', () => {
    expect(storagePath('demo', 'Design/logo.svg')).toBe('demo://Design/logo.svg');
    expect(storagePath('demo', '/Design')).toBe('demo://Design');
    expect(storagePath('demo', '')).toBe('demo://');
  });
});
