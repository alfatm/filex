# filex docker-compose .env example.
# Copy to .env and edit. Anything you leave commented falls back to safe defaults.

# ============================================================================
# Core filex
# ============================================================================
# Registry + namespace every filex image is pulled from. Set this ONE line to
# run a fork's images and everything below follows it — the app image here and
# the toolchain base under "Building from source". Nothing else in the compose
# files names a registry.
# FILEX_IMAGE_BASE=ghcr.io/your-org
#
# Image to run. Overrides FILEX_IMAGE_BASE entirely when set, so use it only to
# pin a tag from somewhere else. The `full` tag adds the programs the
# thumbnailer shells out to (ffmpeg, ghostscript, ...); `slim` is the binary
# alone.
# FILEX_IMAGE=ghcr.io/brf-tech/filex:slim
# FILEX_PORT=5212
# FILEX_PUBLIC_URL=http://localhost:5212

# Auth: comma list of: local, oidc, ldap, proxy_header
# FILEX_AUTH_DRIVERS=local

# OIDC (only used when 'oidc' is in FILEX_AUTH_DRIVERS)
# FILEX_OIDC_ISSUER=https://auth.example.com/realms/main
# FILEX_OIDC_CLIENT_ID=filex
# FILEX_OIDC_CLIENT_SECRET=changeme
# FILEX_OIDC_REDIRECT_URL=https://files.example.com/api/auth/oidc/callback
# SSO-first login: the login page redirects straight to the IdP; the password
# form stays reachable via /admin/login?local=1 (break-glass admin@local).
# FILEX_OIDC_AUTO_REDIRECT=false

# Share the session cookie across subdomains (Domain attribute on
# filex_session). Empty = host-only cookie (default).
# FILEX_COOKIE_DOMAIN=.example.com

# DB driver: sqlite | mysql | postgres
# FILEX_DB_DRIVER=sqlite
# FILEX_DB_DSN=/data/filex.db
# Postgres example:
# FILEX_DB_DRIVER=postgres
# FILEX_DB_DSN=postgres://filex:changeme@postgres:5432/filex?sslmode=disable

# Default storage driver for new installs (admin can add more later)
# FILEX_DEFAULT_STORAGE_DRIVER=local

# Thumbnails (true requires the 'full' image or matching tools on host)
# FILEX_THUMBS_ENABLED=false

# ============================================================================
# Building from source
# ============================================================================
# `docker compose up --build` builds the image from this tree instead of
# pulling it. FILEX_RUNTIME_BASE is the slim/full switch and has to stay in
# step with the tag in FILEX_IMAGE: the default alpine base is slim, the
# toolchain image (docker/Dockerfile.tools) is full. Pin the DATED tag.
# FILEX_RUNTIME_BASE=${FILEX_IMAGE_BASE}/filex-tools:alpine3.20-20260911
# Set to 0 to leave the end-user app out of the build (a couple of minutes
# faster). The apex then serves the admin console instead of the app.
# BUILD_APP=1

# ============================================================================
# First boot
# ============================================================================
# Seed an admin and skip the setup wizard. Leave unset and filex generates a
# password, prints it once and writes it to /data/.first-run.txt (0600).
# FILEX_ADMIN_EMAIL=admin@filex.test
# FILEX_ADMIN_PASSWORD=FilexTest1!
# Name and path of the writable drive created on first boot. The NAME is what
# every node is addressed by (`home://Docs/report.pdf`).
# FILEX_DEFAULT_STORAGE_NAME=home
# FILEX_DEFAULT_STORAGE_PATH=/var/lib/filex/local-storage
# Secretbox key — without it the assistant refuses to store a provider key.
# Changing it later makes stored secrets unreadable, not migrated.
# FILEX_SECRET_KEY=

# ============================================================================
# OnlyOffice (profile: onlyoffice)
# ============================================================================
# Same secret on both sides!
# ONLYOFFICE_JWT_SECRET=please-change-me-shared-with-filex
# FILEX_ONLYOFFICE_URL=http://onlyoffice
# FILEX_ONLYOFFICE_JWT=please-change-me-shared-with-filex
# ONLYOFFICE_PORT=8099

# ============================================================================
# Office thumbnails (profile: libreoffice)
# ============================================================================
# Thumbnails for doc/docx/xls/xlsx/ppt/pptx/odf. LibreOffice is not in the filex
# image — ~730 MB with the JRE it needs — so the conversion runs in its own
# container. Server-side only: this URL is never handed to a browser, so the
# in-network address is the right one, and the service stays unpublished.
# COMPOSE_PROFILES=libreoffice
# FILEX_LIBREOFFICE_URL=http://libreoffice:3000

# ============================================================================
# PostgreSQL (profile: postgres)
# ============================================================================
# POSTGRES_USER=filex
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=filex
# POSTGRES_PORT=5432

# ============================================================================
# MinIO (profile: minio)
# ============================================================================
# MINIO_USER=filex
# MINIO_PASSWORD=changeme-very-long
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ============================================================================
# Drawio (no compose service; just point at a public/self-hosted instance)
# ============================================================================
# FILEX_DRAWIO_URL=https://embed.diagrams.net

# ============================================================================
# E2E key escrow — install-time, with one supervised way to turn it on later
# ============================================================================
# Gives the operator a second way into end-to-end encrypted folders. Off unless
# set. Generate the pair with `filex e2e-escrow keygen`, put the PUBLIC half
# here and keep the PRIVATE half yourself — filex never receives it, so a
# stolen database still decrypts nothing.
#
# ⚠ Pinned at the first boot. filex refuses to start if this key later CHANGES
# or is REMOVED, because a folder wraps its master key to the escrow identity
# when it is created and nothing can rewrite that without the folder password.
# See docs/CONFIGURATION.md#install-time-settings-filex_installation_
# FILEX_INSTALLATION_E2E_ESCROW_KEY=
#
# Turning escrow ON for an installation that already exists is allowed, once,
# and only when you also set the line below. It is NOT retroactive: folders
# created before the adoption have no escrow-wrapped key, and nothing you do
# as operator gives them one. Their OWNERS are offered a slot the next time
# they unlock and can grant it with the folder password — you can ask, not
# take. filex records who and when in installation.json.
# Remove the line again after the boot that adopts; it is ignored afterwards.
# See docs/CONFIGURATION.md#adopting-escrow-later
# FILEX_INSTALLATION_E2E_ESCROW_ADOPT=1
