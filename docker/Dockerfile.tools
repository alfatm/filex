# filex runtime toolchain — the programs the thumbnailer shells out to, with a
# release cycle of their own.
#
#   docker build -f docker/Dockerfile.tools -t filex-tools:alpine3.20 docker/
#
# Why this is not in docker/Dockerfile: these packages change a few times a
# year, the application changes several times a week, and every filex release
# was re-resolving and re-downloading ~340 MB of them on both architectures.
# Published separately, the `full` image is the tools image plus one 170 MB
# binary layer, and a filex release that changes no tool pulls a layer it
# already has.
#
# The application picks it up as the base of its runtime stage:
#   docker build -f docker/Dockerfile \
#     --build-arg RUNTIME_BASE=ghcr.io/brf-tech/filex-tools:alpine3.20-20260911 .
#
# Tags are `alpine<version>-<YYYYMMDD>` plus a moving `alpine<version>`. The
# application pins the DATED one: a rebuild of the toolchain must be an
# explicit filex change, not something that happens to a release under it.
#
# Nothing here knows about filex — no ENTRYPOINT, no ENV, no port. The image is
# a base, and every piece of application metadata stays in docker/Dockerfile so
# the two cannot drift.
FROM alpine:3.20

#   ca-certificates — outbound TLS (S3, WebDAV, OIDC, update checks).
#   tzdata          — local-time rendering and scheduled jobs.
# Both are in the slim image too (docker/Dockerfile installs them itself, which
# is a no-op on this base); they are here so this image is a complete runtime
# base rather than one that only works with that RUN line after it.
#
#   ffmpeg                 — video + audio thumbnails (thumb/video.go, audio.go).
#   ghostscript + poppler  — PDF -> JPEG (page 1). gs preferred, pdftoppm as
#                            fallback (thumb/pdf.go).
#   rsvg-convert           — SVG rasterisation (thumb/svg.go).
#   fonts                  — without them Ghostscript renders the non-ASCII text
#                            of a PDF that embeds no font as boxes.
#
# ⚠ LibreOffice is NOT here, and adding it costs ~730 MB (libreoffice 558 MB +
# the openjdk17 JRE its xlsx/docx pipeline needs, 172 MB — measured on
# alpine:3.20). Office thumbnails go through a conversion SERVICE instead:
# FILEX_LIBREOFFICE_URL, or the `libreoffice` profile in docker-compose.yml.
#
# ⚠ Nothing in filex executes ImageMagick — it was installed and probed for
# years without a single call site. Image thumbnails are pure Go
# (thumb/image.go). Do not add it back without a generator that uses it.
RUN apk --no-cache add \
        ca-certificates \
        tzdata \
        ffmpeg \
        ghostscript \
        poppler-utils \
        rsvg-convert \
        ttf-liberation \
        ttf-dejavu \
        font-noto \
        font-noto-cjk
