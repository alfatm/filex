# Dockerfile.local — builds the image from dist artifacts already on the host,
# skipping the in-image frontend build. Local hot-fix builds only; the canonical
# recipe is docker/Dockerfile.
#
# ⚠ NOT PUBLISHABLE, for two reasons that the file name only hints at:
#
#   1. It is NOT reproducible. The frontend is whatever happens to be sitting
#      in web/dist, packages/webcomponent/dist and app/dist on the machine that
#      runs the build — a stale bundle is embedded silently. The root
#      .dockerignore excludes those directories precisely so the canonical
#      recipe can never pick them up; this file is exempted by its own
#      docker/Dockerfile.local.dockerignore, which BuildKit resolves BY NAME.
#      Rename this file and that exemption stops applying, with no error —
#      the build just breaks somewhere confusing.
#
#   2. It is the FATTEST recipe in the repo, and deliberately off-doctrine: it
#      is the only one that still bundles LibreOffice + a JRE (~730 MB), which
#      everything else routes to a conversion service (FILEX_LIBREOFFICE_URL).
#      Convenient when you are debugging office thumbnails on one machine; not
#      what anybody should ship.
#
# Build (from repo root):
#   pnpm -r --filter='./packages/*' build
#   pnpm --filter='./web' build
#   VITE_FILEX_API=1 pnpm --filter='./app' build
#   docker build -f docker/Dockerfile.local -t filex:local .

# ---------------------------------------------------------------------------
# Stage 1: stage embed assets straight from the host build tree
# ---------------------------------------------------------------------------
FROM alpine:3.20 AS embed-prep
WORKDIR /tmp/embed
COPY web/dist ./admin
COPY packages/webcomponent/dist ./web
COPY app/dist ./app

# ---------------------------------------------------------------------------
# Stage 2: Go binary
# ---------------------------------------------------------------------------
FROM golang:1.25-alpine AS backend-build
RUN apk --no-cache add git ca-certificates
WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
COPY --from=embed-prep /tmp/embed/admin ./embed/admin
COPY --from=embed-prep /tmp/embed/web   ./embed/web
COPY --from=embed-prep /tmp/embed/app   ./embed/app

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
# Symbol path read from go.mod — see docker/Dockerfile for why.
RUN MODULE="$(go list -m)" && \
    CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w \
        -X ${MODULE}/internal/version.Version=${VERSION} \
        -X ${MODULE}/internal/version.Commit=${COMMIT} \
        -X ${MODULE}/internal/version.Date=${DATE}" \
    -o /out/filex \
    ./cmd/filex

# ---------------------------------------------------------------------------
# Stage 3: runtime — same toolchain as the `full` target of docker/Dockerfile
# ---------------------------------------------------------------------------
FROM alpine:3.20
RUN apk --no-cache add \
        ca-certificates \
        tzdata \
        ffmpeg \
        ghostscript \
        poppler-utils \
        libreoffice \
        openjdk17-jre-headless \
        rsvg-convert \
        ttf-liberation \
        ttf-dejavu \
        font-noto \
        font-noto-cjk

COPY --from=backend-build /out/filex /usr/local/bin/filex

EXPOSE 5212
VOLUME ["/data"]

ENV FILEX_DATA_DIR=/data \
    FILEX_LISTEN=0.0.0.0:5212 \
    FILEX_THUMBS_ENABLED=true

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:5212/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/filex"]
CMD ["serve"]
